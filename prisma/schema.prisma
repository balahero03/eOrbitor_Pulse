generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  // Login identifier — NOT guaranteed to be a real, reachable mailbox (many
  // accounts use an internal placeholder domain). Do not send account-recovery
  // mail here; use `personalEmail` once it's verified.
  email              String            @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole          @default(ON_FIELD_TEAM)
  department         String?
  assignedTerritory  String?
  phone              String?
  employeeId         String?           @unique
  jobTitle           String?
  isActive           Boolean           @default(true)
  // Self-service recovery/contact email, set from the Profile page. Nullable
  // because most existing accounts won't have one yet; only usable for
  // password-reset delivery once `personalEmailVerifiedAt` is set.
  personalEmail             String?   @unique
  personalEmailVerifiedAt   DateTime?
  // Every JWT carries the second it was issued (`iat`). Stamping this on any
  // password write lets withAuth reject tokens minted before it, which is the
  // only way a stateless 30-day token can be revoked — without it, resetting
  // a password leaves a thief's stolen session fully alive.
  passwordChangedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  managerId          String?
  activityLogs       ActivityLog[]
  announcements      Announcement[]
  approvalsApproved  ApprovalRequest[] @relation("ApprovalApprovedBy")
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsTargeted  ApprovalRequest[] @relation("ApprovalTargetUser")
  orderPayments      OrderPayment[]    @relation("OrderPaymentRecordedBy")
  transfersFrom      LeadTransfer[]    @relation("LeadTransferFrom")
  transfersTo        LeadTransfer[]    @relation("LeadTransferTo")
  transfersActed     LeadTransfer[]    @relation("LeadTransferActedBy")
  dailyActivities    DailyActivity[]
  deals              Deal[]
  followUps          FollowUp[]
  leads              Lead[]            @relation("LeadAssignedTo")
  broughtLeads       Lead[]            @relation("LeadBroughtBy")
  notifications      Notification[]
  quotations         Quotation[]
  assignedTasks      Task[]            @relation("assignedTo")
  tasks              Task[]
  timeLogs              TimeLog[]
  activityUnlockRequests ActivityUnlockRequest[]
  afterHoursAccessRequests AfterHoursAccessRequest[]
  manager               User?             @relation("UserManager", fields: [managerId], references: [id])
  subordinates          User[]            @relation("UserManager")
  reports               Report[]
  passwordResetChallenges PasswordResetChallenge[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  // Every request from a BACKEND_TEAM user resolves their team with
  // `where: { managerId: <id> }` before it can scope anything — 36 call sites
  // across the API. Without an index that is a sequential scan of User on each
  // one, including inside withAuth-adjacent hot paths like the leads list.
  @@index([managerId])
}

// One "forgot password" attempt, from requesting a code through to setting the
// new password.
//
// Replaces the earlier emailed-link token. Links are pre-fetched by corporate
// mail scanners, which silently spends a single-use token and leaves the real
// user staring at "this link has expired"; a code cannot be spent by merely
// reading the message.
//
// Neither secret is stored in the clear — `codeHash` and `ticketHash` are
// SHA-256 — so a database read alone can never be replayed into a takeover.
// A six-digit code is only 1,000,000 possibilities, so `attempts` is the
// control that makes it safe: without the cap this design would be weaker
// than the tokens it replaces.
model PasswordResetChallenge {
  id              String    @id @default(cuid())
  userId          String
  codeHash        String
  attempts        Int       @default(0)
  expiresAt       DateTime
  verifiedAt      DateTime?
  // Issued only once the code has been verified, so the code itself can never
  // be replayed to set a second password.
  ticketHash      String?   @unique
  ticketExpiresAt DateTime?
  usedAt          DateTime?
  requestIp       String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rate limiting counts recent rows per user and per IP; both reads are
  // covered by these.
  @@index([userId, createdAt])
  @@index([requestIp, createdAt])
  @@index([expiresAt])
}

// One-time tokens proving ownership of a `User.personalEmail` value before
// it's trusted for account recovery. `email` is snapshotted at issue time so
// a stale link can't confirm a since-changed address.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id                 String            @id @default(cuid())
  // System-issued identifier, LD-<year>-<sequence>. Separate from `quoteNo`
  // on purpose: quoteNo is free text (imported spreadsheet S.NO values, or a
  // customer's own quote reference) and was being used for both jobs, which
  // is how quotation numbers ended up displayed as lead numbers. The unique
  // constraint is the part that matters — without it the generator could and
  // did hand the same number to many leads without anything objecting.
  leadNumber         String?           @unique
  name               String
  email              String
  phone              String?
  company            String
  address            String?
  source             LeadSource
  status             LeadStatus        @default(NEW)
  leadScore          Int               @default(0)
  qualificationNotes String?
  assignedToId       String
  nextFollowUp       DateTime?
  linkedCustomerId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  broughtById        String?
  followUpDate       DateTime?
  poReceivedDate     DateTime?
  quoteNo            String?
  quoteValue         Decimal?
  remarks            String?
  rfqDate            DateTime?
  closedAt           DateTime?
  expectedClosureDate DateTime?
  closureReason      String?
  closureDetails     Json?
  // The pipeline stage this lead was parked at when it went ON_HOLD, so it can
  // be resumed where it left off. Without it a hold was a one-way door: the
  // sequential-progression rule saw ON_HOLD as outside the pipeline and would
  // only allow the lead back in at SUSPECT, discarding its position.
  heldFromStatus     LeadStatus?
  solutionAreas      String[]
  oemNames           String[]
  presalesIds        String[]
  activityLogs       ActivityLog[]
  approvalRequests   ApprovalRequest[]
  transfers          LeadTransfer[]
  deals              Deal[]
  followUps          FollowUp[]
  assignedTo         User              @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  broughtBy          User?             @relation("LeadBroughtBy", fields: [broughtById], references: [id])
  linkedCustomer     Customer?         @relation(fields: [linkedCustomerId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  // Soft delete is filtered on in 37 places, and almost never alone — it pairs
  // with the owner on every scoped list, which is what this composite serves.
  @@index([deletedAt])
  @@index([assignedToId, deletedAt])
  // Closed-leads listing sorts and filters on this, and the reports engine
  // measures every "won in period" figure by it.
  @@index([closedAt])
  // Counted per team on the Backend Team dashboard.
  @@index([broughtById])
}

model Customer {
  id               String           @id @default(cuid())
  companyName      String
  gstNumber        String           @unique
  industry         String?
  website          String?
  annualRevenue    Decimal?
  yearEstablished  Int?
  billingAddress   Json?
  shippingAddress  Json?
  customerCategory CustomerCategory @default(PROSPECT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  activityLogs     ActivityLog[]
  contacts         Contact[]
  deals            Deal[]
  leads            Lead[]
  orders           Order[]
  quotations       Quotation[]

  @@index([gstNumber])
  @@index([createdAt])
}

model Contact {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  email       String
  phone       String?
  designation String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Deal {
  id                String        @id @default(cuid())
  customerId        String
  leadId            String?
  dealName          String
  dealValue         Decimal
  stage             DealStage     @default(SUSPECT)
  winProbability    Int           @default(0)
  expectedCloseDate DateTime?
  assignedToId      String
  nextAction        String?
  lostReason        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  closedAt          DateTime?
  activityLogs      ActivityLog[]
  assignedTo        User          @relation(fields: [assignedToId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  lead              Lead?         @relation(fields: [leadId], references: [id])
  followUps         FollowUp[]
  orders            Order[]
  quotations        Quotation[]
  tasks             Task[]

  @@index([stage])
  @@index([customerId])
  @@index([assignedToId])
}

model FollowUp {
  id              String       @id @default(cuid())
  dealId          String
  leadId          String?
  type            FollowUpType
  scheduledDate   DateTime
  actualDate      DateTime?
  durationMinutes Int?
  notes           String?
  outcome         String?
  nextAction      String?
  createdById     String
  reminderSentAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User         @relation(fields: [createdById], references: [id])
  deal            Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead            Lead?        @relation(fields: [leadId], references: [id])
  tasks           Task[]

  @@index([dealId])
  @@index([createdById])
  @@index([scheduledDate])
}

model Task {
  id                String       @id @default(cuid())
  title             String
  description       String?
  status            TaskStatus   @default(TODO)
  priority          TaskPriority @default(MEDIUM)
  dueDate           DateTime?
  assignedToId      String
  relatedDealId     String?
  relatedFollowUpId String?
  createdById       String
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  tags              String[]
  assignedTo        User         @relation("assignedTo", fields: [assignedToId], references: [id])
  createdBy         User         @relation(fields: [createdById], references: [id])
  relatedDeal       Deal?        @relation(fields: [relatedDealId], references: [id])
  relatedFollowUp   FollowUp?    @relation(fields: [relatedFollowUpId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
}

model Quotation {
  id               String          @id @default(cuid())
  dealId           String?
  leadId           String?
  quotationNumber  String          @unique
  customerId       String
  status           QuotationStatus @default(DRAFT)
  issueDate        DateTime
  expiryDate       DateTime?
  priceValidity    String?
  taxDetails       String?
  warranty         String?
  amcPeriod        String?
  deliveryEstimate String?
  paymentTerms     String?
  items            Json
  subtotal         Decimal
  taxAmount        Decimal
  discountAmount   Decimal
  totalAmount      Decimal
  notes            String?
  rejectionReason  String?
  pdfUrl           String?
  sentAt           DateTime?
  approvedById     String?
  approvedAt       DateTime?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  revision         Int             @default(1)
  activityLogs     ActivityLog[]
  orders           Order[]
  createdBy        User            @relation(fields: [createdById], references: [id])
  customer         Customer        @relation(fields: [customerId], references: [id])
  deal             Deal?           @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([customerId])
  @@index([dealId])
}

model Order {
  id            String        @id @default(cuid())
  quotationId   String?
  customerId    String
  dealId        String?
  orderNumber   String        @unique
  poNumber      String?
  poDate        DateTime?
  status        OrderStatus   @default(PENDING)
  deliveryDate  DateTime?
  /// Legacy free-text/URL invoice pointer. Superseded by invoiceNumber +
  /// invoiceFile; kept so existing rows are not silently dropped.
  invoiceUrl      String?
  invoiceNumber   String?
  /// StoredFile descriptor for the uploaded invoice — same disk-backed shape
  /// as OrderPayment.proof, so the PDF never sits inside Postgres.
  invoiceFile     Json?
  paymentStatus   PaymentStatus @default(PENDING)
  /// Credit terms as agreed at closure — free text ("Net 30", "50% advance"),
  /// because that is how the sales team writes them. lib/paymentTerms.ts reads
  /// a day count out of it where it can; where it can't, the text still stands
  /// as the record of what was agreed.
  paymentTerms    String?
  /// When the balance is due. Derived from paymentTerms against the PO date,
  /// or set by hand — an explicit date is never recomputed over. Nullable
  /// because orders predating this, and orders on no agreed terms, have none.
  /// "Overdue" is derived from this and the balance, never stored.
  paymentDueDate  DateTime?
  totalAmount     Decimal
  amountPaid      Decimal       @default(0)
  paymentMode     String?
  paymentRemarks  String?
  paymentProofUrl String?
  createdAt       DateTime      @default(now())
  deliveredAt     DateTime?
  updatedAt       DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id])
  deal          Deal?         @relation(fields: [dealId], references: [id])
  quotation     Quotation?    @relation(fields: [quotationId], references: [id])
  payments      OrderPayment[]

  /// Soft delete, matching Lead / Customer / Deal / Quotation / User.
  ///
  /// Order was the one entity that deleted for real, and it is the one holding
  /// the money: PO number, invoice number, GST-bearing totals — and
  /// `OrderPayment` cascades from it, so removing an order also destroyed the
  /// whole receipt ledger justifying what had been collected. That is both
  /// unrecoverable and the opposite of what Indian financial-record retention
  /// expects. The uploaded invoice and receipt files were left orphaned on disk
  /// as well, since only the descriptor rows went.
  deletedAt       DateTime?

  @@index([status])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([paymentDueDate])
  @@index([deletedAt])
}

/// One recorded receipt of money against an order.
///
/// Before this, an order carried a single running `amountPaid` plus *one*
/// `paymentMode` / `paymentRemarks` / `paymentProofUrl`. Recording a second
/// instalment overwrote the first one's mode, reference and receipt, and
/// nothing recorded when it arrived or who entered it — so a part-paid order
/// could not be reconciled against a bank statement.
///
/// `Order.amountPaid` is kept as a cached sum of these rows (the list query
/// sorts and filters on it); it is recomputed from the ledger on every write
/// rather than incremented, so the two can never drift.
model OrderPayment {
  id         String   @id @default(cuid())
  orderId    String
  amount     Decimal
  /// When the money actually arrived — not when it was typed in. Backdating a
  /// receipt is normal, so this is user-supplied and separate from createdAt.
  paidAt     DateTime @default(now())
  mode       String?
  /// UPI ref / cheque no / NEFT UTR — what you match against a bank statement.
  reference  String?
  remarks    String?
  /// StoredFile metadata from lib/storage (id, filename, contentType, size,
  /// storagePath). The bytes live on disk under FILE_UPLOAD_DIR; only this
  /// descriptor is in Postgres.
  proof      Json?
  recordedById String
  createdAt  DateTime @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User  @relation("OrderPaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([orderId])
  @@index([paidAt])
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  category       String?
  oemName        String?
  description    String?
  basePrice      Decimal
  tax            Decimal
  attributes     Json?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventory      Inventory?
  vendorProducts VendorProduct[]

  @@index([sku])
}

model Inventory {
  id                  String    @id @default(cuid())
  productId           String    @unique
  quantity            Int       @default(0)
  reorderLevel        Int?
  warehouseLocation   String?
  lastRestockDate     DateTime?
  lastRestockQuantity Int?
  updatedAt           DateTime  @updatedAt
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Vendor {
  id           String          @id @default(cuid())
  vendorName   String
  gstNumber    String          @unique
  email        String?
  phone        String?
  website      String?
  paymentTerms String?
  rating       Int?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  products     VendorProduct[]

  @@index([vendorName])
}

model VendorProduct {
  id           String  @id @default(cuid())
  vendorId     String
  productId    String
  vendorSku    String
  vendorPrice  Decimal
  leadTime     Int?
  minimumOrder Int?
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor       Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, productId])
  @@index([vendorId])
}


model ActivityLog {
  id          String         @id @default(cuid())
  userId      String
  action      ActivityAction
  entityType  String
  entityId    String
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())
  leadId      String?
  customerId  String?
  dealId      String?
  quotationId String?
  customer    Customer?      @relation(fields: [customerId], references: [id])
  deal        Deal?          @relation(fields: [dealId], references: [id])
  lead        Lead?          @relation(fields: [leadId], references: [id])
  quotation   Quotation?     @relation(fields: [quotationId], references: [id])
  user        User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ApprovalRequest {
  id              String         @id @default(cuid())
  type            ApprovalType
  entityType      String
  entityId        String
  leadId          String?
  requestedBy     String
  approvedBy      String?
  /// Proposed new owner. Only LEAD_TRANSFER sets this; every other approval
  /// type acts on the entity alone and leaves it null.
  targetUserId    String?
  status          ApprovalStatus @default(PENDING)
  reason          String?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approvedByUser  User?          @relation("ApprovalApprovedBy", fields: [approvedBy], references: [id])
  lead            Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requestedByUser User           @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  targetUser      User?          @relation("ApprovalTargetUser", fields: [targetUserId], references: [id])

  @@index([status])
  @@index([entityType])
  @@index([requestedBy])
  @@index([approvedBy])
  @@index([targetUserId])
}

/// Audit trail of lead ownership changes, powering the transfer history shown
/// on the lead's People panel.
///
/// Deliberately its own table rather than a read of ActivityLog: that table
/// records every field edit with the delta in a JSON `changes` blob, so
/// rendering a clean "A → B, by C, because D" timeline would mean scanning and
/// parsing unrelated rows. Ownership is also the one change people ask about
/// months later, which earns it a first-class, indexed record.
model LeadTransfer {
  id            String   @id @default(cuid())
  leadId        String
  /// Null when the lead had no prior owner.
  fromUserId    String?
  toUserId      String
  /// Who actually performed it: the admin who transferred directly, or
  /// whoever accepted the request.
  actedById     String
  /// Set when the transfer came from a request, so history can show it went
  /// through review rather than being applied directly.
  viaApprovalId String?
  reason        String?
  createdAt     DateTime @default(now())

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUser User? @relation("LeadTransferFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("LeadTransferTo", fields: [toUserId], references: [id])
  actedBy  User  @relation("LeadTransferActedBy", fields: [actedById], references: [id])

  @@index([leadId])
  @@index([createdAt])
}

model DailyActivity {
  id           String    @id @default(cuid())
  userId       String
  date         String
  activities   String
  loginTime    DateTime?
  logoutTime   DateTime?
  totalHours   Decimal?
  notes        String?
  isEditable   Boolean   @default(true)
  unlockedBy   String?
  unlockedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model TimeLog {
  id              String    @id @default(cuid())
  userId          String
  loginTime       DateTime
  logoutTime      DateTime?
  sessionDuration Int?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginTime])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  createdById String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  priority    String    @default("NORMAL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@index([createdById])
  @@index([publishedAt])
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  BACKEND_TEAM
  ON_FIELD_TEAM
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALKIN
  CALL
  EMAIL
  ADVERTISEMENT
  /// A lead that came in over WhatsApp — a routine inbound channel for this
  /// business (Follow-up already treats WhatsApp as a real contact method;
  /// this was the one place a lead's *origin* couldn't be recorded as one).
  WHATSAPP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  REJECTED
  CONVERTED
  SUSPECT
  PROSPECT
  APPROACH
  PROPOSAL
  NEGOTIATION
  CLOSURE
  WON
  LOST
  DROPPED
  ON_HOLD
  ORDER
}

enum CustomerCategory {
  PROSPECT
  ACTIVE
  INACTIVE
  LOST
}

enum DealStage {
  SUSPECT
  PROSPECT
  APPROACH
  NEGOTIATION
  CLOSURE
  ONGOING
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  SITE_VISIT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  INVOICED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
}


enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  SEND_EMAIL
}

enum NotificationType {
  FOLLOW_UP_REMINDER
  TASK_DUE
  DEAL_UPDATED
  LEAD_ASSIGNED
  QUOTATION_APPROVED
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  PAYMENT_DUE
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  TASK_ASSIGNED
  USER_INACTIVE
}

model ActivityUnlockRequest {
  id              String    @id @default(cuid())
  userId          String
  date            String
  reason          String
  status          String    @default("PENDING")
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AccessPolicy {
  id              String     @id @default("singleton")
  enabled         Boolean    @default(false)
  restrictedRoles UserRole[] @default([])
  windowStart     String     @default("21:00")
  windowEnd       String     @default("08:00")
  forceCutoff     Boolean    @default(false)
  updatedBy       String?
  updatedAt       DateTime   @updatedAt
  createdAt       DateTime   @default(now())
}

// Master switch for quotation-creation permissions. By default only an
// admin/manager or a lead's assigned owner may create a quotation for it;
// an admin can flip restrictionsDisabled to let every user create a
// quotation for any lead — a temporary, fully-reversible override rather
// than a role change.
model QuotationPolicy {
  id                   String   @id @default("singleton")
  restrictionsDisabled Boolean  @default(false)
  updatedBy            String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model AfterHoursAccessRequest {
  id              String         @id @default(cuid())
  userId          String
  date            String
  reason          String
  status          ApprovalStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, date])
}

enum ApprovalType {
  LEAD_DELETE
  LEAD_REOPEN
  ORDER_DELETE
  CUSTOMER_DELETE
  // Handover of a lead's ownership. Unlike the delete/reopen types, this one
  // needs to say *who to* — see ApprovalRequest.targetUserId.
  LEAD_TRANSFER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Report {
  id          String    @id @default(cuid())
  type        String
  userId      String?
  managerId   String?
  startDate   DateTime
  endDate     DateTime
  data        Json
  generatedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([type, createdById, startDate])
  @@index([createdAt])
}

model ScheduledReport {
  id              String    @id @default(cuid())
  type            String
  userId          String?
  managerId       String?
  frequency       String
  dayOfWeek       Int?
  dayOfMonth      Int?
  recipients      String[]
  isActive        Boolean   @default(true)
  lastGeneratedAt DateTime?
  nextRunAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([nextRunAt, isActive])
}
